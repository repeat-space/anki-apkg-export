{
  "name": "anki-apkg-export",
  "version": "5.0.0",
  "description": "Generate decks for Anki (spaced repetition software)",
  "keywords": [
    "anki",
    "spaced repetition software",
    "webpack"
  ],
  "license": "MIT",
  "author": "ewnd9 <ewndnine@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repeat-space/anki-apkg-export.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sql-wasm.wasm": "./dist/sql-wasm.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-wasm.mjs",
    "lint": "oxlint src test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark": "node --import @oxc-node/core/register scripts/benchmark.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "he": "^1.2.0",
    "jszip": "^3.10.2",
    "sha1": "^1.1.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@oxc-node/core": "^0.1.3",
    "@types/he": "^1.2.3",
    "@types/node": "^24.0.0",
    "@types/sha1": "^1.1.5",
    "@types/sql.js": "^1.4.9",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.1"
}
